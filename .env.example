# PostgreSQL Password
PG_PASSWORD=

# PostgreSQL Connection Details (for telemetry collection)
# These environment variables make telemetry provider-agnostic (Docker, AWS, GCP, etc.)
PG_PRIMARY_HOST=
PG_PRIMARY_PORT=
PG_PRIMARY_DATABASE=
PG_PRIMARY_USER=

# Replica connection details (comma-separated for multiple replicas)
PG_REPLICA_HOSTS=
PG_REPLICA_PORTS=
PG_REPLICA_DATABASE=
PG_REPLICA_USER=

# Grafana Cloud Credentials (optional, for telemetry push)
GRAFANA_CLOUD_ENDPOINT=
GRAFANA_CLOUD_API_KEY=
GRAFANA_CLOUD_USER=

# Telemetry Labels (optional - have sensible defaults)
TELEMETRY_CLUSTER=
TELEMETRY_ENVIRONMENT=
TELEMETRY_PROVIDER=